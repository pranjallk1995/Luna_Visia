# Copy this file to .env and replace every placeholder before starting Visia.

# Local database and vision model settings.
POSTGRES_PASSWORD=lunavisia-dev
VISION_MODEL=qwen2.5vl:7b

# Public MCP/API origin used when Visia creates stable image URLs.
# Leave blank when public image URLs are not needed.
LUNAVISIA_PUBLIC_BASE_URL=

# Private UI-to-backend credential. This is not issued by any service: make up your own
# random value of at least 32 characters, e.g. with `openssl rand -hex 32`.
LUNAVISIA_API_TOKEN=replace-with-a-private-random-value-of-at-least-32-characters

# Comma-separated, verified Google accounts allowed to use the Streamlit UI.
LUNAVISIA_ALLOWED_EMAILS=you@example.com

# Public origin of the MCP server, used for its icon URLs.
# Must be HTTPS when exposed publicly; plain HTTP is accepted only on localhost.
MCP_PUBLIC_URL=http://localhost:18000
